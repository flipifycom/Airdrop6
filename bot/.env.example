# ===== Telegram (from my.telegram.org) =====
TG_API_ID=123456
TG_API_HASH=abcdef0123456789abcdef
TG_SESSION=1A2B3C...your_session_string...

# ===== Bot token for notifications (from @BotFather) — REQUIRED for manual fallback =====
TG_BOT_TOKEN=1234:abcd...
# Chat ID where YES + "manual action needed" alerts are sent (your own user id)
NOTIFY_CHAT_ID=123456789

# ===== AI provider (free) =====
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# ===== Base44 (Dashboard -> API) =====
BASE44_APP_ID=your-app-id
BASE44_API_KEY=your-workspace-api-key
BASE44_API_BASE=https://base44.app

# ===== Behaviour =====
CONFIG_REFRESH_SECONDS=300
DEFAULT_AUTONOMY=full_autonomy
RESEARCH_INTERVAL=3600
RESEARCH_MAX_NEW=5
# How often the daily-task loop runs (seconds). 21600 = 6h
DAILY_INTERVAL=21600

# Live toggles (auto_join / auto_tap / auto_research / target_airdrops) are read
# from the dashboard's BotSetting entity (Settings page).
