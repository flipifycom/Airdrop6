# ===== Telegram (from my.telegram.org) =====
TG_API_ID=123456
TG_API_HASH=abcdef0123456789abcdef
# Pyrogram session string (generate via the snippet in the README)
TG_SESSION=1A2B3C...your_session_string...

# ===== Bot token for notifications (optional, from @BotFather) =====
TG_BOT_TOKEN=1234:abcd...
# Chat ID where YES-signal alerts are sent (your own user id or a channel)
NOTIFY_CHAT_ID=123456789

# ===== AI provider (free) =====
# Groq key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Base44 (Dashboard -> API, copy the values shown there) =====
# App id from the editor URL (/apps/<APP_ID>/editor)
BASE44_APP_ID=your-app-id
# Workspace API key (Workspace Settings -> Preferences -> API Key)
BASE44_API_KEY=your-workspace-api-key
# API base as shown in the Dashboard Python snippet (no trailing slash)
BASE44_API_BASE=https://www.base44.com

# ===== Behaviour =====
# Refresh monitored groups + settings every N seconds (default 300)
CONFIG_REFRESH_SECONDS=300
# Default autonomy if not set in BotSetting: full_autonomy | human_in_loop | logging_only
DEFAULT_AUTONOMY=human_in_loop
